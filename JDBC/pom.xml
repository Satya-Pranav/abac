<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.abacpoc</groupId>
  <artifactId>jdbc-client</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Databricks JDBC OSS uber jar. Reproduces the auth mechanism the customer's
         DatabricksConnectionProxy.java uses: com.databricks.jdbc.* and
         com.databricks.internal.sdk.core.oauth.* (bundled inside this same artifact). -->
    <dependency>
      <groupId>com.databricks</groupId>
      <artifactId>databricks-jdbc</artifactId>
      <version>3.4.1</version>
    </dependency>

    <!-- e6data JDBC driver. NOTE: this coordinate does not resolve from any configured remote
         repository — it must be installed into the local repo first via install-file. See
         "Running against e6data" in docs/deployment/runbook.md for the exact command and for the
         deliberate version/jar-build mismatch that command creates. -->
    <dependency>
      <groupId>com.e6data</groupId>
      <artifactId>e6-jdbc-driver</artifactId>
      <version>1.0.1</version>
    </dependency>

    <!-- Parses onetrust_sanity_run_annotated.csv for OnetrustCases. The 50 real query texts
         contain embedded commas, quotes, and newlines, so a proper RFC4180 parser is needed
         rather than hand-rolled splitting. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.11.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <!-- CAUTION for whoever adds the NEXT JDBC driver: jar-with-dependencies OVERWRITES
             META-INF/services/* rather than merging them, so only ONE driver's
             META-INF/services/java.sql.Driver entry survives into the shaded jar. Today the
             Databricks entry wins and e6data's is clobbered — which is why
             E6DataEngine.connect() calls Class.forName("io.e6.jdbc.driver.E6Driver")
             explicitly. Which driver survives is an accident of unpack order, NOT pinned
             behavior: it can flip on a dependency-order or plugin-version change, with no
             compile-time signal — only a runtime "No suitable driver found". If you add a
             third driver, load it explicitly too, or switch to maven-shade-plugin with
             ServicesResourceTransformer (which merges service files properly). -->
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.abacpoc.Runner</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- e6data-only build. maven-assembly-plugin's naive unpack-and-overwrite merge does NOT
           combine duplicate META-INF/services/* entries across dependency jars (see the caution
           above), confirmed the hard way: e6data-jdbc-driver's own transitive dependencies
           contribute MULTIPLE io.grpc.{NameResolverProvider,ManagedChannelProvider,
           LoadBalancerProvider,ServerProvider} registrations, assembly-plugin only kept one
           source's copy (wrong byte-for-byte vs. e6data's own proven-working demo jar), and the
           resulting broken gRPC provider discovery made every single statement on the connection
           fail with "UNKNOWN: status: 456, authenticate processed with custom error code",
           reproduced even excluding databricks-jdbc from the assembly, so it was never actually
           about the two drivers coexisting; it was this merge bug. maven-shade-plugin's
           ServicesResourceTransformer merges (concatenates) these files correctly instead of
           picking one arbitrarily. Also excludes com.databricks:databricks-jdbc: Runner.main()
           never loads DatabricksEngine when ENGINE=e6data, so it isn't needed here, and dropping
           it keeps this jar smaller. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>e6data-only</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>e6data-only</shadedClassifierName>
              <artifactSet>
                <excludes>
                  <exclude>com.databricks:databricks-jdbc</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.abacpoc.Runner</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
